# ═════════════════════════════════════════════════════════════════════════
# VyBot Environment Variables
# Copy this file to .env.local and fill in your values
# ═════════════════════════════════════════════════════════════════════════

# ─── FREE AI PROVIDERS (Herhangi biri veya birkaçı yeterlidir) ───────────
# VyBot en az bir anahtar olduğunda çalışır; rate-limit olunca diğerine geçer!

# 1. Google Gemini (Önerilen - Ücretsiz 15 RPM, 1500 İstek/Gün, 1M Context)
# https://aistudio.google.com -> "Get API key"
GEMINI_API_KEY=

# 2. Groq (Ultra Hızlı - Ücretsiz Llama 3.3 70B & Llama 3.1 8B, 14.400 İstek/Gün)
# https://console.groq.com -> "API Keys"
GROQ_API_KEY=

# 3. Cerebras Cloud (Dünyanın en hızlı çıkarımı - Ücretsiz 30 RPM, 1M Token/Gün)
# https://cloud.cerebras.ai -> "API Keys"
CEREBRAS_API_KEY=

# 4. NVIDIA NIM (1.000 Ücretsiz Kredi)
# https://build.nvidia.com -> "Get API Key"
NVIDIA_API_KEY=

# 5. OpenRouter (Tamamen ücretsiz :free modelleri)
# https://openrouter.ai -> "Keys"
OPENROUTER_API_KEY=

# 6. Mistral AI (Ücretsiz La Plateforme katmanı)
# https://console.mistral.ai -> "API Keys"
MISTRAL_API_KEY=

# 7. GitHub Models (Kişisel GitHub Token ile ücretsiz GPT-4o-mini & Llama)
# https://github.com/settings/tokens -> "Generate new token"
GITHUB_TOKEN=

# 8. Hugging Face Serverless Inference API
# https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# Geliştirme/Çevrimdışı Modda API Anahtarı Olmadan Test Etmek İçin:
ALLOW_MOCK_AI=true

# ─── DATABASE ────────────────────────────────────────────────────────────
DATABASE_URL=              # Neon PostgreSQL connection string (https://neon.tech)
UPSTASH_REDIS_URL=         # Upstash Redis REST URL (https://upstash.com)
UPSTASH_REDIS_TOKEN=       # Upstash Redis REST token
TURSO_URL=                 # Turso database URL (https://turso.tech)
TURSO_AUTH_TOKEN=          # Turso auth token

# ─── SECURITY ────────────────────────────────────────────────────────────
# Kimlik bilgilerini AES-256-GCM ile şifrelemek için 64 karakter hex veya parola
VYBOT_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ─── PLATFORM BOT TOKENS (İsteğe bağlı) ──────────────────────────────────
DISCORD_BOT_TOKEN=         # Discord Developer Portal bot token
TELEGRAM_BOT_TOKEN=        # BotFather telegram bot token

# ─── AGENT CONFIGURATION ─────────────────────────────────────────────────
HEALTH_PORT=3001           # Health check sunucu portu
